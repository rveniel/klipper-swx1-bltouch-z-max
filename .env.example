# Copier en .env et adapter.

# Nom du projet compose
COMPOSE_PROJECT_NAME=klipper-swx1

# Dossier où ce repo est cloné sur Unraid (chemin absolu : Compose Manager
# range ses fichiers sur la clé USB, les chemins relatifs n'y marcheraient pas)
STACK_DIR=/mnt/user/appdata/klipper-swx1-bltouch-z-max

# Port de l'interface web (le 80 est pris par la WebUI Unraid)
HTTP_PORT=8090

# Webcam : préférer le chemin stable de /dev/v4l/by-id/...-video-index0
WEBCAM_DEVICE=/dev/video0
