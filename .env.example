# Dossier des données de la stack (configs, G-codes, base Moonraker, logs)
STACK_DIR=/mnt/user/appdata/klipper-swx1

# Port de l'interface web (le 80 est pris par la WebUI Unraid)
HTTP_PORT=8090

# Port série de la carte : ls /dev/serial/by-id/
# Utilisé uniquement à la création de printer.cfg (premier démarrage).
MCU_SERIAL=/dev/serial/by-id/usb-1a86_USB2.0-Serial-if00-port0

# Webcam : préférer le chemin stable de /dev/v4l/by-id/...-video-index0
WEBCAM_DEVICE=/dev/video0

# Branche ou tag du repo dont viennent les configs par défaut
CONFIG_REF=main
